# copy to .env for deployment overrides — docker compose reads this automatically

# Browser-facing LiveKit URL. The web proxy forwards /livekit to the SFU, so
# the same origin works locally and remotely:
#   local/LAN (default):  http://localhost/livekit   (or http://192.168.1.10/livekit)
#   with the TLS overlay: https://192.168.1.10/livekit
LIVEKIT_URL=http://localhost/livekit

# LiveKit API credentials — MUST stay in sync (used by both livekit and server).
# Generate a strong pair: `docker run --rm livekit/livekit-server:v1.13.1 generate-keys`
# The server refuses to start on known example secrets.
LIVEKIT_API_KEY=devkey
LIVEKIT_SECRET=pgv-dev-secret-please-change-me-0123456789abcdef

# Port the web UI is published on (host side)
WEB_PORT=8080
# Web'in host'a bağlandığı arayüz. Varsayılan 127.0.0.1 = host nginx
# (deploy/nginx-postacim.conf) tek giriş noktası. Host nginx'siz LAN modu:
# WEB_HOST=0.0.0.0
WEB_HOST=127.0.0.1

# Ekran paylaşımı kill switch. Varsayılan açık; 'off' yapılırsa ses token'larından
# screen_share publish izni düşer ve yayın LiveKit'te fiziksel olarak reddedilir.
# Değiştirince yalnız server'ı yeniden başlatmak yeter: docker compose up -d server
#SCREEN_SHARE=on

# Oturum çerezi süresi (gün). Varsayılan 30.
#SESSION_TTL_DAYS=30

# Bot koruması (opsiyonel) — Cloudflare Turnstile. Site key girilirse kayıt/girişte
# widget derlenir; secret sunucu tarafında doğrulanır. Boş = özellik kapalı.
#VITE_TURNSTILE_SITEKEY=
#TURNSTILE_SECRET=
# Dev/testing: kayıt limiti (prod 3 kalsın)
REGISTER_RATE_PER_HOUR=3
