# CCE (code-context-engine)
.cce/
.claude/settings.local.json
.mcp.json

# node
node_modules/

# build output
dist/

# runtime data (sqlite etc.)
data/

# VPS-only state — gitignored, .example sürümü repo'da
# .env gerçek değerleri tutar (API key, secret); /etc/postacim/.env'de tutulur
.env
.env.local
.env.production
.env.development
# livekit.yaml gerçek node_ip'yi tutar; /etc/postacim/livekit.yaml'da tutulur
livekit/livekit.yaml
# web tarafı env (build-time Vite argümanları)
web/.env
web/.env.local

# logs
*.log

# Let's Encrypt çalışma dizinleri (özel anahtar içerir)
certbot/
*.bak

# TLS sertifikaları — scripts/gen-certs.sh üretir, repo'ya girmez (özel anahtar!)
certs/
